# Base URL of the Vendly backend API, without a trailing path.
# Required: the app throws at startup if this is missing.
VITE_API_BASE_URL=http://localhost:3000

# Cloudinary unsigned upload settings (used for listing images and shop logos).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Google sign-in: the "Client ID" of the Web application in the Google Cloud console (Google Auth
# Platform > Clients). The client ID only, never the secret. Without it the "Continue with Google"
# button is hidden. The site's address (http://localhost:5173 and the live address) must be listed
# under "Authorized JavaScript origins" there.
VITE_GOOGLE_CLIENT_ID=
